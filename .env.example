# Copy to .env and fill in. .env is ignored by Git. Never commit real keys.

# --- Owner (the pharmacy owner). Only needed for owner:* commands. ---
# Controls the Altana wallet: grants and revokes the agent's session key.
# Keep it off the machine the agent runs on once the session is granted.
OWNER_PRIVATE_KEY=

# --- Agent ---
# The session key the owner granted. Only needed for agent commands.
SESSION_PRIVATE_KEY=

# Loops House attribution code for this entry. Every mainnet transaction carries it.
ATTRIBUTION_CODE=celo_3175e01fb588

# Celo mainnet RPC (public default if empty).
CELO_RPC_URL=https://forno.celo.org

# Where the agent reads stock levels. "sample" uses data/sample-inventory.json.
# "haxenmed" calls a HaxenMed instance's restock API with the key below.
INVENTORY_SOURCE=sample
HAXENMED_URL=
HAXENMED_API_KEY=

# Local guards on top of the onchain session cap (USD₮, whole dollars).
MAX_USDT_PER_ORDER=25
MAX_USDT_PER_RUN=50
